{
  "rules": {
    ".read": false,
    ".write": false,
    "ages": {
      ".read": "auth != null && query.orderByValue == true && query.limitToFirst <= 50",
      ".indexOn": [".value"],
      "$code": {
        ".write": "auth != null && ((!data.exists() && newData.parent().parent().child('rooms').child($code).child('host').val() === auth.uid) || (data.exists() && !newData.exists() && (!newData.parent().parent().child('rooms').child($code).exists() || root.child('rooms').child($code).child('host').val() === auth.uid || root.child('rooms').child($code).child('guest').val() === auth.uid || data.val() < now - 7200000)))",
        ".validate": "$code.matches(/^[0-9]{4}$/) && newData.isNumber() && newData.val() <= now"
      }
    },
    "rooms": {
      "$code": {
        ".read": "auth != null && (data.child('host').val() === auth.uid || data.child('guest').val() === auth.uid)",
        ".write": "auth != null && ((!data.exists() && newData.child('host').val() === auth.uid) || (data.exists() && !newData.exists() && (data.child('host').val() === auth.uid || data.child('guest').val() === auth.uid || data.child('createdAt').val() < now - 7200000)))",
        ".validate": "$code.matches(/^[0-9]{4}$/) && newData.hasChildren(['host', 'createdAt'])",
        "host": {
          ".validate": "newData.isString() && newData.val().length <= 128"
        },
        "createdAt": {
          ".validate": "newData.isNumber() && newData.val() <= now"
        },
        "guest": {
          ".write": "auth != null && newData.val() === auth.uid && (!data.exists() || data.val() === auth.uid) && data.parent().child('host').exists() && data.parent().child('host').val() !== auth.uid",
          ".validate": "newData.isString() && newData.val().length <= 128"
        },
        "presence": {
          "$role": {
            ".write": "auth != null && (($role === 'A' && root.child('rooms').child($code).child('host').val() === auth.uid) || ($role === 'B' && root.child('rooms').child($code).child('guest').val() === auth.uid))",
            ".validate": "newData.isBoolean()"
          }
        },
        "ready": {
          ".write": "auth != null && !newData.exists() && root.child('rooms').child($code).child('host').val() === auth.uid",
          "$role": {
            ".write": "auth != null && (($role === 'A' && root.child('rooms').child($code).child('host').val() === auth.uid) || ($role === 'B' && root.child('rooms').child($code).child('guest').val() === auth.uid))",
            ".validate": "newData.isBoolean()"
          }
        },
        "state": {
          ".write": "auth != null && root.child('rooms').child($code).child('host').val() === auth.uid",
          ".validate": "newData.hasChildren(['phase', 'g'])",
          "phase": { ".validate": "newData.isString() && newData.val().matches(/^(play|end)$/)" },
          "g": { ".validate": "newData.isNumber()" },
          "round": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() < 10" },
          "t0": { ".validate": "newData.isNumber()" },
          "word": { ".validate": "newData.isString() && newData.val().length <= 20" },
          "cat": { ".validate": "newData.isString() && newData.val().length <= 10" },
          "opts": {
            "$i": { ".validate": "$i.matches(/^[0-3]$/) && newData.isString() && newData.val().length <= 20" }
          },
          "$other": { ".validate": false }
        },
        "strokes": {
          ".write": "auth != null && (root.child('rooms').child($code).child('host').val() === auth.uid || root.child('rooms').child($code).child('guest').val() === auth.uid)",
          "$r": {
            ".validate": "$r.matches(/^[0-9]$/)",
            "$id": {
              ".validate": "newData.hasChildren(['s', 'p'])",
              "s": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() < 400" },
              "p": { ".validate": "newData.isString() && newData.val().length <= 3000" },
              "$other": { ".validate": false }
            }
          }
        },
        "answers": {
          ".write": "auth != null && (root.child('rooms').child($code).child('host').val() === auth.uid || root.child('rooms').child($code).child('guest').val() === auth.uid)",
          "$r": {
            ".validate": "$r.matches(/^[0-9]$/) && newData.hasChildren(['pick', 'ms'])",
            "pick": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 3" },
            "ms": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 20000" },
            "$other": { ".validate": false }
          }
        },
        "$other": { ".validate": false }
      }
    }
  }
}
